# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.claude/
.cursor/

# Raw source media (camera originals). Too big for git; only the web encodes
# generated from these are committed.
/media-src/

# The design lab is local-only: it shows Medara work that is not cleared for
# publication yet (pending approval). The whole lab, code and assets, stays out
# of git so nothing can push it by accident. When the section is promoted, the
# real component and its cleared assets live elsewhere and the lab is deleted.
/src/app/design-lab/
/public/design-lab/
